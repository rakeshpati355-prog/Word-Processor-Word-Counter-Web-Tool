<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Word Processor & Word Counter</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --success: #16a34a;
      --danger: #dc2626;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    header {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: white;
      padding: 20px 16px 26px;
      text-align: center;
    }
    header h1 {
      margin: 0 0 6px;
      font-size: 26px;
    }
    header p {
      margin: 0;
      opacity: 0.9;
      font-size: 13px;
    }

    main {
      max-width: 1000px;
      margin: -18px auto 40px;
      padding: 0 16px;
    }

    .card {
      background: var(--card);
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(2, 6, 23, 0.06);
      padding: 16px;
      margin-bottom: 16px;
    }
    .card h2 {
      margin: 0 0 10px;
      font-size: 18px;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
    }
    .toolbar button, .toolbar select {
      background: #f1f5f9;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 13px;
      color: var(--text);
      cursor: pointer;
    }
    .toolbar button:hover, .toolbar select:hover {
      background: #e2e8f0;
    }
    .toolbar button.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    .editor-wrapper {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      min-height: 260px;
      max-height: 500px;
      overflow: auto;
      padding: 12px;
      line-height: 1.6;
      font-size: 15px;
    }
    .editor {
      outline: none;
      min-height: 240px;
    }
    .editor:empty::before {
      content: "Start typing your document here...";
      color: var(--muted);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
      margin-top: 12px;
    }
    @media (max-width: 800px) {
      .stats-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 500px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .stat-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px;
      text-align: center;
    }
    .stat-label {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .stat-value {
      font-size: 18px;
      font-weight: 700;
      color: var(--primary);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }
    .actions button {
      background: var(--primary);
      color: white;
      border: none;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      cursor: pointer;
    }
    .actions button:hover {
      background: var(--primary-dark);
    }
    .actions button.secondary {
      background: #e2e8f0;
      color: var(--text);
    }
    .actions button.secondary:hover {
      background: #cbd5e1;
    }
    .actions button.danger {
      background: var(--danger);
    }
    .actions button.danger:hover {
      background: #b91c1c;
    }

    .note {
      font-size: 12px;
      color: var(--muted);
      margin-top: 8px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Word Processor & Word Counter</h1>
    <p>Rich text editor with live word, character, sentence, paragraph counts and reading time</p>
  </header>

  <main>
    <section class="card">
      <h2>Document Editor</h2>

      <div class="toolbar">
        <button data-cmd="bold" title="Bold"><b>B</b></button>
        <button data-cmd="italic" title="Italic"><i>I</i></button>
        <button data-cmd="underline" title="Underline"><u>U</u></button>
        <button data-cmd="strikeThrough" title="Strikethrough"><s>S</s></button>
        <select id="formatBlock" title="Heading / Paragraph">
          <option value="P">Paragraph</option>
          <option value="H1">Heading 1</option>
          <option value="H2">Heading 2</option>
          <option value="H3">Heading 3</option>
          <option value="BLOCKQUOTE">Quote</option>
          <option value="PRE">Code Block</option>
        </select>
        <button data-cmd="insertUnorderedList" title="Bullet List">• List</button>
        <button data-cmd="insertOrderedList" title="Numbered List">1. List</button>
        <button data-cmd="justifyLeft" title="Align Left">Left</button>
        <button data-cmd="justifyCenter" title="Align Center">Center</button>
        <button data-cmd="justifyFull" title="Justify">Justify</button>
        <button id="linkBtn" title="Insert Link">🔗 Link</button>
        <button data-cmd="removeFormat" title="Clear Formatting">Clear</button>
      </div>

      <div class="editor-wrapper">
        <div id="editor" class="editor" contenteditable="true" spellcheck="true"></div>
      </div>

      <div class="stats-grid">
        <div class="stat-box">
          <div class="stat-label">Words</div>
          <div class="stat-value" id="wordCount">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Characters</div>
          <div class="stat-value" id="charCount">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Characters (no spaces)</div>
          <div class="stat-value" id="charNoSpaceCount">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Sentences</div>
          <div class="stat-value" id="sentenceCount">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Paragraphs</div>
          <div class="stat-value" id="paragraphCount">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Reading Time</div>
          <div class="stat-value" id="readingTime">0s</div>
        </div>
      </div>

      <div class="actions">
        <button id="downloadTxtBtn">Download as .txt</button>
        <button id="downloadHtmlBtn">Download as .html</button>
        <button id="copyHtmlBtn" class="secondary">Copy HTML</button>
        <button id="clearBtn" class="danger">Clear Document</button>
      </div>

      <p class="note">All processing happens in your browser. No data is sent to any server. [69][72][84]</p>
    </section>
  </main>

  <script>
    const editor = document.getElementById("editor");
    const wordCountEl = document.getElementById("wordCount");
    const charCountEl = document.getElementById("charCount");
    const charNoSpaceCountEl = document.getElementById("charNoSpaceCount");
    const sentenceCountEl = document.getElementById("sentenceCount");
    const paragraphCountEl = document.getElementById("paragraphCount");
    const readingTimeEl = document.getElementById("readingTime");

    const toolbarButtons = document.querySelectorAll(".toolbar button[data-cmd]");
    const formatBlockSelect = document.getElementById("formatBlock");
    const linkBtn = document.getElementById("linkBtn");
    const downloadTxtBtn = document.getElementById("downloadTxtBtn");
    const downloadHtmlBtn = document.getElementById("downloadHtmlBtn");
    const copyHtmlBtn = document.getElementById("copyHtmlBtn");
    const clearBtn = document.getElementById("clearBtn");

    // --- Text analysis ---
    function getText() {
      return editor.innerText || "";
    }

    function getHtml() {
      return editor.innerHTML || "";
    }

    function countWords(text) {
      // Match sequences of word characters; handles most Latin scripts well
      const matches = text.match(/\w+/g);
      return matches ? matches.length : 0;
    }

    function countSentences(text) {
      // Simple sentence split on . ! ? followed by space or end
      const trimmed = text.trim();
      if (!trimmed) return 0;
      const parts = trimmed.split(/[.!?]+(?:\s|$)/);
      const filtered = parts.filter(p => p.trim().length > 0);
      return filtered.length || (trimmed ? 1 : 0);
    }

    function countParagraphs(text) {
      const trimmed = text.trim();
      if (!trimmed) return 0;
      // Split on double newlines or single newlines
      const parts = trimmed.split(/\n\s*\n|\n/);
      const filtered = parts.filter(p => p.trim().length > 0);
      return filtered.length || 1;
    }

    function estimateReadingTime(words) {
      // Average adult reading speed ~ 200–250 wpm; using 220 wpm
      const wpm = 220;
      const minutes = words / wpm;
      const totalSeconds = Math.round(minutes * 60);
      if (totalSeconds < 60) {
        return totalSeconds + "s";
      }
      const m = Math.floor(totalSeconds / 60);
      const s = totalSeconds % 60;
      return `${m}m ${s}s`;
    }

    function updateStats() {
      const text = getText();
      const words = countWords(text);
      const chars = text.length;
      const charsNoSpace = text.replace(/\s/g, "").length;
      const sentences = countSentences(text);
      const paragraphs = countParagraphs(text);
      const readTime = estimateReadingTime(words);

      wordCountEl.textContent = words;
      charCountEl.textContent = chars;
      charNoSpaceCountEl.textContent = charsNoSpace;
      sentenceCountEl.textContent = sentences;
      paragraphCountEl.textContent = paragraphs;
      readingTimeEl.textContent = readTime;
    }

    // --- Toolbar actions (using execCommand; deprecated but still widely supported for simple editors) [70][73][76][82][85] ---
    toolbarButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const cmd = btn.dataset.cmd;
        document.execCommand(cmd, false, null);
        editor.focus();
        updateStats();
      });
    });

    formatBlockSelect.addEventListener("change", () => {
      const tag = formatBlockSelect.value;
      document.execCommand("formatBlock", false, tag);
      editor.focus();
      updateStats();
    });

    linkBtn.addEventListener("click", () => {
      const url = prompt("Enter URL for the link:");
      if (!url) return;
      document.execCommand("createLink", false, url);
      editor.focus();
      updateStats();
    });

    // --- File actions ---
    downloadTxtBtn.addEventListener("click", () => {
      const text = getText();
      const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "document.txt";
      a.click();
      URL.revokeObjectURL(a.href);
    });

    downloadHtmlBtn.addEventListener("click", () => {
      const htmlContent = getHtml();
      const fullHtml =
        `<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<title>Document</title>\n</head>\n<body>\n${htmlContent}\n</body>\n</html>`;
      const blob = new Blob([fullHtml], { type: "text/html;charset=utf-8" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "document.html";
      a.click();
      URL.revokeObjectURL(a.href);
    });

    copyHtmlBtn.addEventListener("click", async () => {
      const htmlContent = getHtml();
      try {
        await navigator.clipboard.writeText(htmlContent);
        alert("HTML copied to clipboard.");
      } catch {
        // Fallback
        const ta = document.createElement("textarea");
        ta.value = htmlContent;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
        alert("HTML copied to clipboard (fallback).");
      }
    });

    clearBtn.addEventListener("click", () => {
      if (!confirm("Clear the entire document?")) return;
      editor.innerHTML = "";
      updateStats();
      editor.focus();
    });

    // --- Live update on input ---
    editor.addEventListener("input", updateStats);
    editor.addEventListener("keyup", updateStats);
    editor.addEventListener("mouseup", updateStats);

    // Initial stats
    updateStats();
  </script>
</body>
</html>
